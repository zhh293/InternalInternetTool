serverHost=tunnel.example.com
controlPort=7000
workPort=7001
clientId=home-pc
tokenFile=/etc/tunnel/token
# Optional independent credential; overrides tokenFile when set.
# clientTokenFile=/etc/tunnel/client-home-pc.token
caFile=/etc/tunnel/ca.crt
map.ssh=22022,127.0.0.1,22
map.web=28080,127.0.0.1,8080
# UDP mapping keeps datagram boundaries: udp.dns=25353,127.0.0.1,53
# HTTP Host routes use the server httpPort: http.web=example.com|www.example.com,127.0.0.1,8080
# Optional URL prefixes, Host rewrite and per-proxy controls:
# http.web.locations=/api|/health
# http.web.hostRewrite=internal.example
# http.web.basicUser=admin
# http.web.basicPassword=change-me
# balance.web=web-group,shared-key
# health.web=tcp,3,3,10
# bandwidth.web=1MB
# muxPoolSize=2
# Separate TLS/TCP work connections dedicated to UDP to avoid TCP stream head-of-line blocking.
# Set to 0 to carry UDP on the TCP pool (default: 1).
# udpMuxPoolSize=1
# latency (default): flush immediately outside read loops; balanced: batch until an event-loop task.
# flushMode=latency
# Disable Nagle's algorithm on TCP connections (default: true).
# tcpNoDelay=true
# maxPendingBytes=8388608
# Per-stream TCP/HTTP receive window (64 KiB to 64 MiB; default 256 KiB).
# Increase for high-bandwidth, high-latency links; this raises per-stream buffering.
# flowWindowBytes=262144
# Aggregate outstanding TCP/HTTP windows per client process (default 512 MiB).
# maxFlowWindowBytes=536870912
# UDP socket send/receive buffer per local UDP stream (default 256 KiB).
# udpSocketBufferBytes=262144
# High watermark for queued writes on UDP-only TLS mux channels.
# Lower values apply backpressure sooner during overload; default is 8 MiB.
# udpMuxWriteBufferHighWaterMarkBytes=8388608
# Both ends must enable this and use udpMuxPoolSize > 1.
# Spreads one UDP stream across mux connections; datagram order may change.
# udpMuxStriping=false
# Dedicated Netty UDP I/O threads (default: half the detected CPUs, capped at 8).
# udpIoThreads=2
